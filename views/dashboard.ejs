<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />
        <title>Pil Reminder ~ Dashboard</title>
        <link
            rel="stylesheet"
            href="./css/bs5.css"
            type="text/css"
            media="all"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        />
        <script
            src="./js/bs5.js"
            type="text/javascript"
            charset="utf-8"
        ></script>
    </head>
    <body>
        <div class="container">
            <!-- Navbar -->
            <nav class="navbar">
                <div
                    class="container-fluid bg-primary-subtle rounded"
                >
                    <div class="navbar-brand d-flex align-items-center justify-content-between w-100">
                        <h1 class="text-uppercase fw-bolder mt-2">
                            Hai, <%= username %>!
                        </h1>
                    <a href="/logout" class="btn btn-danger">Logout</a>
                    </div>
                </div>
            </nav>
            <!-- List Pengingat -->
              <% if (!drugs) { %>
    <p>Ooops! List Obat Masih Kosong, Yuk Tambah Obat Dulu...</p>
  <% } else { %>
        <% drugs.forEach(drug => { %>
            <div class="card mt-3 shadow">
                <div
                    class="card-body d-flex align-items-center justify-content-between"
                >
                    <div
                        class="labelPil d-flex align-items-center justify-content-center"
                    >
                        <img
                            src="./img/medicine.png"
                            alt="Capsule"
                            id="labelPict"
                            width="25"
                        />
                        <span class="h3 pt-2 ms-2 text-uppercase fw-bold"
                            >            <%= drug.nama_obat %></span
                        >
                    </div>
                    <div
                        class="rounded bg-secondary-subtle d-flex align-items-center px-3 py-1"
                    >
                        <img
                            src="./img/capsule.png"
                            alt="Capsule"
                            id="labelPict"
                            width="13.5"
                        /><span id="curentPils" class="fs-5 ms-2"><%= drug.total_obat %></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div
                        class="d-flex align-items-center justify-content-between"
                    >
                        <button type="button" class="btn btn-sm btn-primary">
                            Pil Tersisa
                            <span class="badge text-bg-secondary"><%= drug.total_obat %> pil</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-primary">
                            Durasi
                            <span class="badge text-bg-secondary">Auto</span>
                        </button>
                    </div>
                    <div>
                        <sub class="text-center text-secondary"
                            >Pengingat: 08:00 / 14:00 / 20:00</sub
                        >
                    </div>
                </div>
            </div>
      <% }) %>
  <% } %>

            <!-- Button trigger modal -->
            <button
                type="button"
                class="btn btn-primary position-fixed shadow"
                data-bs-toggle="modal"
                data-bs-target="#staticBackdrop"
                style="bottom: 3rem; right: 2rem"
            >
                <i class="bi bi-plus-lg fs-2"></i>
            </button>

            <!-- Modal -->
            <div
                class="modal fade"
                id="staticBackdrop"
                data-bs-backdrop="static"
                data-bs-keyboard="false"
                tabindex="-1"
                aria-labelledby="staticBackdropLabel"
                aria-hidden="true"
            >
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1
                                class="modal-title fs-5"
                                id="staticBackdropLabel"
                            >
                                Tambahkan Pengingat
                            </h1>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            ></button>
                        </div>
                        <div class="modal-body">
                            <form action="/add-drug" method="post">
                                <div class="mb-3">
                                    <label for="namaObat" class="form-label"
                                        >Nama Obat</label
                                    >
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="namaObat"
                                        name="nama_obat"
                                        placeholder="Ex: Paracetamol"
                                        autofocus
                                    />
                                </div>
                                <!-- Tipe Obat -->
                                <div class="mb-3">
                                    <label for="obatType" class="form-label"
                                        >Jenis Obat</label
                                    >
                                    <select
                                        class="form-select form-select-md mb-3"
                                        aria-label="Large select example"
                                        id="obatType" name="tipe_obat"
                                    >
                                        <option selected>
                                            ---
                                        </option>
                                        <option value="Kapsul">
                                            Kapsul
                                        </option>
                                        <option value="Tablet">
                                            Tablet
                                        </option>
                                        <option value="Sirup">Sirup</option>
                                        <option value="Salep">Salep</option>
                                    </select>
                                </div>
                                <!-- Syarat Minum Obat -->
                                <div class="mb-3">
                                    <label for="syaratObat" class="form-label"
                                        >Harus diminum saat apa:</label
                                    >
                                    <select
                                        class="form-select form-select-md mb-3"
                                        aria-label="Large select example"
                                        id="obatType"
                                        name="ketentuan_obat" required
                                    >
                                        <option selected>
                                            ---
                                        </option>
                                        <option value="sebelum makan">
                                            Sebelum Makan
                                        </option>
                                        <option value="setelah makan">
                                            Setelah Makan
                                        </option>
                                        <option value="satu jam sebelum makan">
                                            Satu Jam Sebelum Makan
                                        </option>
                                        <option value="satu jam setelah makan">
                                            Satu Jam Setelah Makan
                                        </option>
                                    </select>
                                </div>
                                <!-- Berapa Kali Sehari -->
                                <div class="mb-3">
                                    <label for="xObat" class="form-label"
                                        >Sehari Berapa Kali</label
                                    >
                                    <input
                                        type="number"
                                        class="form-control"
                                        id="xObat"
                                        name="sehari_berapa"
                                        placeholder="Ex: 3"
                                        autofocus
                                    />
                                </div>
                                <!-- Berapa Obat Sehari -->
                                <div class="mb-3">
                                    <label for="onePilInput" class="form-label"
                                        >Sekali Berapa Pil</label
                                    >
                                    <input
                                        type="number"
                                        class="form-control"
                                        id="onePilInput"
                                        name="sekali_berapa"
                                        placeholder="Ex: 2"
                                        aria-describeby="totalObatDesc"
                                        autofocus
                                    />
                                    <div id="totalObatDesc" class="form-text">
                                        Total obat mempengaruhi pengingat
                                        otomatis
                                    </div>
                                </div>
                                <!-- Total Obat -->
                                <div class="mb-3">
                                    <label for="totalObat" class="form-label"
                                        >Total Obat
                                    </label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="totalObat"
                                        name="total_obat"
                                        placeholder="Ex: 9"
                                        aria-describeby="totalObatDesc"
                                        autofocus
                                    />
                                    <div id="totalObatDesc" class="form-text">
                                        Total obat mempengaruhi pengingat
                                        otomatis
                                    </div>
                                </div>
                                <!-- Atur Waktu Mulai Minum Obat Obat -->
                                <div class="mb-3">
                                    <input
                                        type="hidden"
                                        class="form-control"
                                        name="waktu_pengingat" value="07:00"
                                    />
                                </div>
                                <div class="modal-footer">
                                    <button
                                        type="submit"
                                        class="btn btn-primary w-50 text-uppercase fw-bolder shadow"
                                        name="tambahPengingat"
                                    >
                                        <i class="bi bi-plus-lg"></i>
                                        Tambah
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </body>
</html>

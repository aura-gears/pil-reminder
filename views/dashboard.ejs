
            <!-- List Pengingat -->
            <div class="card mt-1.5 shadow" style="cursor: pointer">
                <div
                    class="card-body d-flex align-items-center justify-content-between"
                >
                    <div
                        class="labelPil d-flex align-items-center justify-content-center"
                    >
                        <img
                            src="./img/medicine.png"
                            alt="Capsule"
                            id="labelPict"
                            width="25"
                        />
                        <span class="h3 pt-2 ms-2 text-uppercase fw-bold"
                            >Paracetamol</span
                        >
                    </div>
                    <div
                        class="rounded bg-secondary-subtle d-flex align-items-center px-3 py-1"
                    >
                        <img
                            src="./img/capsule.png"
                            alt="Capsule"
                            id="labelPict"
                            width="13.5"
                        /><span id="curentPils" class="fs-5 ms-2">8</span>
                    </div>
                </div>
                <div class="card-footer">
                    <div
                        class="card bg-secondary-subtle mb-3 p-2"
                        id="codeCard"
                    >
                        <code lang="application/json" class="text-dark">
                            Data of Pil Reminder</code
                        >
                        <div class="btn btn-secondary mt-1" id="copyCode">
                            copy
                        </div>
                    </div>
                    <div
                        class="d-flex align-items-center justify-content-between"
                    >
                        <button type="button" class="btn btn-sm btn-primary">
                            Pil Tersisa
                            <span class="badge text-bg-secondary">8 pil</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-primary">
                            Total Awal
                            <span class="badge text-bg-secondary">9 pil</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-primary">
                            Durasi
                            <span class="badge text-bg-secondary">Auto</span>
                        </button>
                    </div>
                    <div>
                        <sub class="text-center text-secondary"
                            >24/04/2025, 00.05</sub
                        >
                    </div>
                </div>
            </div>

            <!-- Button trigger modal -->
            <button
                type="button"
                class="btn btn-primary position-absolute shadow"
                data-bs-toggle="modal"
                data-bs-target="#staticBackdrop"
                style="bottom: 3rem; right: 2rem"
            >
                <i class="bi bi-plus-lg fs-2"></i>
            </button>

            <!-- Modal -->
            <div
                class="modal fade"
                id="staticBackdrop"
                data-bs-backdrop="static"
                data-bs-keyboard="false"
                tabindex="-1"
                aria-labelledby="staticBackdropLabel"
                aria-hidden="true"
            >
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1
                                class="modal-title fs-5"
                                id="staticBackdropLabel"
                            >
                                Tambahkan Pengingat
                            </h1>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            ></button>
                        </div>
                        <div class="modal-body">
                            <form action="" method="post">
                                <div class="mb-3">
                                    <label for="namaObat" class="form-label"
                                        >Nama Obat</label
                                    >
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="namaObat"
                                        name="text"
                                        placeholder="Ex: Paracetamol"
                                        autofocus
                                    />
                                </div>
                                <!-- Tipe Obat -->
                                <div class="mb-3">
                                    <label for="obatType" class="form-label"
                                        >Tipe Obat</label
                                    >
                                    <select
                                        class="form-select form-select-md mb-3"
                                        aria-label="Large select example"
                                        id="obatType"
                                    >
                                        <option selected>
                                            Pilih Tipe Obat
                                        </option>
                                        <option value="pilKapsul">
                                            Pil Kapsul
                                        </option>
                                        <option value="pilTablet">
                                            Pil Tablet
                                        </option>
                                        <option value="sirup">Sirup</option>
                                    </select>
                                </div>
                                <!-- Syarat Minum Obat -->
                                <div class="mb-3">
                                    <label for="syaratObat" class="form-label"
                                        >Syarat Obat</label
                                    >
                                    <select
                                        class="form-select form-select-md mb-3"
                                        aria-label="Large select example"
                                        id="obatType"
                                    >
                                        <option selected>
                                            Syarat Minum Obat!
                                        </option>
                                        <option value="sebelum makan">
                                            Sebelum Makan
                                        </option>
                                        <option value="setelah makan">
                                            Setelah Makan
                                        </option>
                                        <option value="satu jam sebelum makan">
                                            Satu Jam Sebelum Makan
                                        </option>
                                        <option value="satu jam setelah makan">
                                            Satu Jam Setelah Makan
                                        </option>
                                    </select>
                                </div>
                                <!-- Berapa Kali Sehari -->
                                <div class="mb-3">
                                    <label for="xObat" class="form-label"
                                        >Sehari Berapa Kali</label
                                    >
                                    <input
                                        type="number"
                                        class="form-control"
                                        id="xObat"
                                        name="xObat"
                                        placeholder="Ex: 3"
                                        autofocus
                                    />
                                </div>
                                <!-- Berapa Obat Sehari -->
                                <div class="mb-3">
                                    <label for="onePilInput" class="form-label"
                                        >Sekali Berapa Pil</label
                                    >
                                    <input
                                        type="number"
                                        class="form-control"
                                        id="onePilInput"
                                        name="onePilInput"
                                        placeholder="Ex: 2"
                                        aria-describeby="totalObatDesc"
                                        autofocus
                                    />
                                    <div id="totalObatDesc" class="form-text">
                                        Total obat mempengaruhi pengingat
                                        otomatis
                                    </div>
                                </div>
                                <!-- Total Obat -->
                                <div class="mb-3">
                                    <label for="totalObat" class="form-label"
                                        >Total Obat
                                    </label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="totalObat"
                                        name="totalObat"
                                        placeholder="Ex: 9 pil"
                                        aria-describeby="totalObatDesc"
                                        autofocus
                                    />
                                    <div id="totalObatDesc" class="form-text">
                                        Total obat mempengaruhi pengingat
                                        otomatis
                                    </div>
                                </div>
                                <!-- Atur Waktu Mulai Minum Obat Obat -->
                                <div class="mb-3">
                                    <label
                                        for="startReminder"
                                        class="form-label"
                                        >Atur Waktu Awal Minum Obat</label
                                    >
                                    <input
                                        type="datetime-local"
                                        class="form-control"
                                        id="startReminder"
                                        name="startReminder"
                                        autofocus
                                    />
                                </div>
                                <div class="modal-footer">
                                    <button
                                        type="submit"
                                        class="btn btn-primary w-50 text-uppercase fw-bolder shadow"
                                        name="tambahPengingat"
                                    >
                                        <i class="bi bi-plus-lg"></i>
                                        Tambah
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

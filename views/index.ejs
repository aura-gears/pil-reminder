<div class="w-100 h-100" style="display:flex;align-items:center;justify-content:center;">
        <div class="card p-3 mt-5">
            <h1>Selamat datang di Pil Reminder</h1>
            <hr />
            <p>Pil Reminder merupakan system pengingat waktu minum obat secara otomatis yang akan mengirimkan sebuah pesan kepada user yang telah menambahkan daftar obat yang ingin diberikan waktu pengingat.</p>
            <a href="/login" class="btn btn-primary fw-bold text-uppercase">Login Pil Reminder</a>
        </d>
</div>

<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
</head>
<body>
  <h1>Selamat datang, <%= username %>!</h1>
  <a href="/logout">Logout</a>

  <h2>Form Tambah Obat</h2>
  <form method="post" action="/add-drug">
    <label>Nama Obat: <input type="text" name="nama_obat" required></label><br/>
    <label>Tipe Obat: <input type="text" name="tipe_obat" required></label><br/>
    <label>Ketentuan Obat: <input type="text" name="ketentuan_obat" required></label><br/>
    <label>Sehari Berapa Kali (angka): <input type="number" name="sehari_berapa" min="1" max="3" required></label><br/>
    <label>Sekali Berapa (dosis): <input type="number" name="sekali_berapa" min="1" required></label><br/>
    <label>Waktu Pengingat (pisah dengan koma, jam 24 format, misal: 8,14,20): <input type="text" name="waktu_pengingat" required></label><br/>
    <label>Total Obat (jumlah tablet/botol): <input type="number" name="total_obat" min="1" required></label><br/>
    <button type="submit">Tambah Obat</button>
  </form>

  <h2>Daftar Obat</h2>
  <% if (!drugs) { %>
    <p>Ooops! List Obat Masih Kosong, Yuk Tambah Obat Dulu...</p>
  <% } else { %>
    <ul>
      <% drugs.forEach(drug => { %>
        <li>
          <b><%= drug.nama_obat %></b> - <%= drug.tipe_obat %><br/>
          Ketentuan: <%= drug.ketentuan_obat %><br/>
          Dosis: <%= drug.sehari_berapa %>x sehari, <%= drug.sekali_berapa %> per kali minum<br/>
          Waktu Pengingat: <%= drug.waktu_pengingat %><br/>
          Total Obat: <%= drug.total_obat %> 
          <% if (drug.total_obat === 0) { %>
            <span style="color:red; font-weight:bold;">(Obat Habis)</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>